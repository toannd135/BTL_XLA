# Segmentation detector; select a YOLO segmentation checkpoint with all 3 fruit classes.
MODEL_PATH=../runs/seg/seg_boundary_candidate_gpu/weights/best.pt
INFERENCE_PROVIDER=local_yolo
DEVICE=auto
CONF=0.4
NMS_IOU=0.6
MODEL_IMGSZ=640
HALF=1

# Optional state and semantic classifiers run on CPU by default to reserve CUDA for one detector.
CLASSIFIER_CHECK=1
CLS_MODEL_PATH=../exports/cls_finetune_best.pt
CLASSIFIER_DEVICE=cpu
CLIP_CHECK=0
CLIP_DEVICE=cpu

# Roboflow cloud inference (placeholders; provider is not implemented yet).
ENABLE_ROBOFLOW=false
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=
ROBOFLOW_API_URL=
ROBOFLOW_CONFIDENCE=0.4
ROBOFLOW_OVERLAP=0.5
ROBOFLOW_TIMEOUT_SECONDS=15
