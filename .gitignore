# Code, models, datasets, notebooks, reports, ZIP inputs, out/ and runs/
# are allowed in Git. Large ZIP files use Git LFS (.gitattributes).

# Per-machine environments and installed dependencies.
.venv/
venv/
env/
node_modules/
dist/
build/
*.egg-info/
/out/pdf_reader_tools/

# Regenerable runtime caches, including downloaded CLIP cache.
__pycache__/
*.py[cod]
*.cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.ipynb_checkpoints/
/work/weights/hf/
/out/ultralytics_config/

# Machine/account credentials; keep configuration examples.
.env
.env.*
!.env.example
!.env.*.example
kaggle.json

# Local Git recovery copies contain old indexes/configs and duplicate trees.
# Keep them on this machine, outside the published project contents.
/out/git-*
/out/merge-main-*/
/out/update-main-*/
/out/latest-merge-backup-path.txt

# Operating-system files.
.DS_Store
Thumbs.db
Desktop.ini
