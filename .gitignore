# Tài nguyên cần bàn giao được phép track:
# exports/ (*.pt, *.onnx), local_dataset/, own_cam/, own_neg/, own_mixed/,
# docs/, tools/, notebooks và file cấu hình mẫu.

# Giữ script và metadata audit cần tái lập; các file sinh ra trong work bỏ qua.
/work/**
!/work/**/
!/work/**/*.py
!/work/audit/*.csv
!/work/audit/*.json
!/work/audit/quarantine_train.txt

# Kết quả có thể tạo lại; không commit bản zip trùng dataset đã giải nén.
out/
runs/
backup_*/
*.zip
*.cache
*.log

# Môi trường và cache mỗi máy tự tạo sau khi clone.
.venv/
venv/
env/
node_modules/
dist/
build/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.ipynb_checkpoints/
*.egg-info/

# Thông tin riêng của từng máy/tài khoản; giữ file cấu hình mẫu.
.env
.env.*
!.env.example
!.env.*.example
kaggle.json

# File của hệ điều hành.
.DS_Store
Thumbs.db
Desktop.ini
